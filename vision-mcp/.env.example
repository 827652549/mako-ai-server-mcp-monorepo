# Vision MCP Server 环境变量
# cp .env.example .env 并填入实际值

PROJECT_NAME=Vision MCP Server
VERSION=1.0.0

# MCP 服务鉴权 Key（用 openssl rand -hex 32 生成，远程部署时对外保密）
MCP_API_KEY=your-generated-key-here

# 视觉模型配置（小米中转，Anthropic 兼容）
VISION_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic
VISION_AUTH_TOKEN=your-xiaomi-token-here
VISION_MODEL=mimo-v2.5
VISION_MAX_TOKENS=2048
VISION_TIMEOUT=60.0

ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8001"]
LOG_LEVEL=INFO
JSON_LOGS=true
PROMETHEUS_ENABLED=true
HTTP_CLIENT_TIMEOUT=60.0
HTTP_CLIENT_MAX_KEEPALIVE_CONNECTIONS=20
HTTP_CLIENT_MAX_CONNECTIONS=50
HOST=0.0.0.0
PORT=8001
